{
  "name": "seventyfive-hard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --env-file-if-exists=.env.local scripts/api-server.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/ && vitest run",
    "check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "test:api": "node --test tests/",
    "test:game": "vitest run"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "@supabase/postgrest-js": "^2.109.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
