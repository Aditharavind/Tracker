# Vercel-compatible API backend (server/, api/index.js). Not used by the
# WSL dev.sh workflow, which still runs the Python/FastAPI backend locally.
#
# Leave both unset for local Node dev -- the API falls back to an in-memory
# store so you can still work on the UI without a database. On Vercel these
# MUST be set in the project's environment variables, or the API refuses to
# start (see server/store/index.js).

# Project Settings -> API -> Project URL
SUPABASE_URL=

# Project Settings -> API keys -> secret (never the publishable/anon key --
# this one bypasses row-level security and must never reach the browser)
SUPABASE_SECRET_KEY=
