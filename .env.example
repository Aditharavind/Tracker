# Server-side only. Never prefix these with VITE_ or they get baked into the
# browser bundle.
SUPABASE_URL=https://ghnylrjpppmgwhahqleu.supabase.co

# Supabase dashboard -> Project Settings -> API keys -> "secret" key
# (older projects call this the service_role key). It bypasses RLS, so treat
# it like a password: never commit it, never paste it into a chat.
SUPABASE_SECRET_KEY=

# Optional. Turns on the AI habit coach (GET /api/users/:id/coach). Without it
# the coach still works, from a deterministic rule-based fallback -- the key
# only changes who writes the phrasing, never the numbers.
# platform.openai.com -> API keys. Server-side only. On Vercel, add it under
# Project Settings -> Environment Variables (not here).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
